# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real secrets.

# Canonical origin used for per-route <link rel="canonical">, og:url and
# Twitter metadata. Also update public/robots.txt and public/sitemap.xml when
# the production domain changes.
VITE_SITE_URL=https://goldenglowqr.com

# Supabase — required for accounts, jobs, applications and the admin panel.
# Both values are public and safe in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values for api/contact.js. Set these in Vercel, not in VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional salt for the IP hashes used by the enquiry rate limit.
IP_HASH_SALT=

# Contact email delivery (server-only).
SMTP_PASS=
SMTP_USER=info@goldenglowqr.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
MAIL_TO=info@goldenglowqr.com

# Optional server-side origin override for the contact API.
SITE_URL=https://goldenglowqr.com
